# Copy to .env in the repo root if you want to override local defaults.
# Docker Compose reads this file for JWT_SECRET and JWT_EXPIRES_IN.
# Never commit a real .env.

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/chatnest
PORT=4000
